{
  "$schema": "./schemas/tokens.schema.json",
  "version": "1.0.0",
  "brand": "FRATV",
  "tagline": "CONTENIDO DIGITAL HUMANO",
  "color": {
    "red": {
      "value": "#B72A3A",
      "role": "accent",
      "note": "Color maestro. No convertir en fucsia, burdeos ni rojo brillante."
    },
    "ink": {
      "value": "#100B18",
      "role": "surface"
    },
    "ivory": {
      "value": "#F5F1E8",
      "role": "text"
    },
    "night": {
      "value": "#08070C",
      "role": "canvas"
    },
    "plate": {
      "value": "rgba(16,11,24,0.94)",
      "role": "data-plate"
    },
    "archive": {
      "orange": {
        "value": "#FF6B3D",
        "deprecated": true,
        "note": "Solo archivo histórico."
      },
      "royalBlue": {
        "value": "#0B1F4D",
        "deprecated": true,
        "note": "Dirección descartada."
      }
    }
  },
  "themes": {
    "fratv-oficial": {
      "accent": "red",
      "onAccent": "ivory",
      "surface": "ink",
      "text": "ivory",
      "canvas": "night",
      "default": true
    },
    "fratv-invertido": {
      "accent": "red",
      "onAccent": "ivory",
      "surface": "ivory",
      "text": "ink",
      "canvas": "ivory"
    },
    "fratv-mono-marfil": {
      "accent": "ivory",
      "onAccent": "ink",
      "surface": "ink",
      "text": "ivory",
      "canvas": "night"
    },
    "fratv-mono-negro": {
      "accent": "ink",
      "onAccent": "ivory",
      "surface": "ivory",
      "text": "ink",
      "canvas": "ivory"
    }
  },
  "typography": {
    "presets": {
      "aprobado": {
        "display": {
          "family": "Poppins",
          "weights": [
            500,
            600,
            700
          ]
        },
        "mono": {
          "family": "JetBrains Mono",
          "weights": [
            400,
            500,
            700
          ]
        },
        "wordmark": {
          "family": "Arial Rounded MT Bold",
          "fallback": "Poppins"
        },
        "default": true
      },
      "editorial": {
        "display": {
          "family": "Instrument Sans",
          "weights": [
            500,
            600,
            700
          ]
        },
        "mono": {
          "family": "IBM Plex Mono",
          "weights": [
            400,
            600
          ]
        },
        "wordmark": {
          "family": "Poppins",
          "weights": [
            700
          ]
        }
      },
      "neutro": {
        "display": {
          "family": "Inter",
          "weights": [
            500,
            600,
            700
          ]
        },
        "mono": {
          "family": "Roboto Mono",
          "weights": [
            400,
            700
          ]
        },
        "wordmark": {
          "family": "Helvetica Rounded",
          "fallback": "Poppins"
        }
      }
    },
    "roles": {
      "title": {
        "font": "display",
        "weight": 700,
        "tracking": "-0.015em",
        "lineHeight": 1.05,
        "minPx": 24
      },
      "name": {
        "font": "display",
        "weight": 600,
        "tracking": "-0.01em",
        "lineHeight": 1
      },
      "body": {
        "font": "display",
        "weight": 500,
        "tracking": "0",
        "lineHeight": 1.45
      },
      "label": {
        "font": "mono",
        "weight": 700,
        "tracking": "0.18em",
        "uppercase": true
      },
      "labelSoft": {
        "font": "mono",
        "weight": 400,
        "tracking": "0.16em",
        "uppercase": true
      },
      "clock": {
        "font": "mono",
        "weight": 700,
        "tracking": "0.06em",
        "tabularNums": true
      },
      "wordmark": {
        "font": "wordmark",
        "weight": 700,
        "tracking": "0.01em"
      },
      "taglineLockup": {
        "font": "display",
        "weight": 700,
        "trackingRatio": 0.115,
        "uppercase": true,
        "note": "Tracking proporcional al cuerpo del wordmark."
      }
    },
    "sources": {
      "presets": true,
      "googleFonts": true,
      "userUpload": [
        "woff2",
        "ttf",
        "otf"
      ]
    }
  },
  "radius": {
    "tile": "0.2564em",
    "plate": 14,
    "pill": 22,
    "chip": 7,
    "note": "tile es proporcional al lado del contenedor: 134/523. plate y pill corregidos a los valores de SPEC_GEOMETRIA.md y de los recursos reales."
  },
  "space": {
    "plateX": 16,
    "plateY": 13,
    "pillX": 16,
    "pillY": 9,
    "gapStack": 12
  },
  "safeArea": {
    "16:9": {
      "action": "5%",
      "title": "10%",
      "exceptions": [
        "ticker"
      ]
    },
    "9:16": {
      "top": "12%",
      "bottom": "22%",
      "flag": "14%",
      "lowerThird": "25%"
    },
    "1:1": {
      "action": "6%",
      "title": "11%"
    },
    "4:5": {
      "top": "10%",
      "bottom": "18%"
    }
  },
  "motion": {
    "fps": 60,
    "easing": {
      "enter": "cubic-bezier(.22,.9,.24,1)",
      "exit": "cubic-bezier(.5,0,.1,1)",
      "wipe": "cubic-bezier(.3,0,.2,1)",
      "linear": "linear"
    },
    "durations": {
      "identLong": 1900,
      "identShort": 900,
      "stinger": 800,
      "wipeIn": 420,
      "textIn": 320,
      "hold": 160,
      "exit": 380
    },
    "rules": [
      "Solo transform, opacity y clip-path en recursos de permanencia.",
      "Rotación del play entre 4 y 7 grados. Nunca escala como recurso expresivo.",
      "En el logo ident el play no se desplaza.",
      "La pose final coincide exactamente con el SVG maestro."
    ]
  },
  "effects": {
    "available": [
      "blur",
      "glow",
      "vignette",
      "lightSweep",
      "grain",
      "motionBlur",
      "chromaticEdge"
    ],
    "policy": {
      "allowed": [
        "ident",
        "stinger",
        "bumper-in",
        "bumper-out",
        "end-credits"
      ],
      "restricted": [
        "flag",
        "live-badge",
        "lower-third",
        "ticker",
        "countdown",
        "engagement"
      ],
      "note": "Glow y blur sobre canal alfa degradan en VP9. En recursos restringidos la app los desactiva y sugiere exportar a ProRes 4444."
    }
  },
  "audio": {
    "slots": [
      "enter",
      "accent",
      "loop",
      "exit"
    ],
    "defaults": {
      "gainDb": -6,
      "fadeMs": 40
    },
    "rules": [
      "Sincronización al cuadro.",
      "Mezcla solo en MP4 y ProRes; WebM alfa y PNG salen mudos.",
      "Nunca audio en recursos de permanencia con loop infinito."
    ]
  }
}