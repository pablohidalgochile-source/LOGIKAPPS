{
  "manifest_version": 3,
  "name": "Track Hunt · Reconocer YouTube",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "description": "Identifica fragmentos de la pestaña YouTube elegida, sin sonido, y envía resultados al asistente local.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:43871/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Track Hunt · Identificar este set"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:43871"
  }
}
